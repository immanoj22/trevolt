# Copy to .env and load with: node --env-file=.env server.js
PORT=5000
# AES key for the encrypted REST envelope; must match the web/mobile clients' secret key
SECRET=demo
# Dev-only placeholders: replace outside a local demo
JWT_SECRET=dev-user-jwt-secret-change-me
ADMIN_JWT_SECRET=dev-admin-jwt-secret-change-me
# Optional: SQLite file location (default data/trevolt.db)
# DB_FILE=./data/trevolt.db

# Seed accounts, created only when the database is empty (demo values)
SEED_DEMO_EMAIL=alex@demo.com
SEED_DEMO_PASSWORD=Demo@12345
SEED_ADMIN_EMAIL=admin@trevolt.test
SEED_ADMIN_PASSWORD=Admin@12345
