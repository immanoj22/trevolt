  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "cmake": "rm -rf android/app/build/ android/app/.cxx/",
    "lint": "eslint .",
    "start": "npx react-native start --reset-cache",
    "cc": "rimraf node_modules/.cache/babel-loader/*,",
    "start:dev": "npm run cc && gulp set --env=dev && npx react-native start --reset-cache --port=8081",
    "start:demo": "npm run cc && gulp set --env=demo && npx react-native start --reset-cache --port=8081",
    "start:prod": "npm run cc && gulp set --env=prod && npx react-native start --reset-cache --port=8081",
    "start:stage": "npm run cc && gulp set --env=stage && npx react-native start --reset-cache  --port=8081",
    "test": "jest",
    "clean": "cd ./android \n ./gradlew clean",
    "release:demo": "npm run cc && gulp set --env=demo && cd android \n  ./gradlew clean  \n ./gradlew assembleRelease",
    "release:stage": "npm run cc && gulp set --env=stage && cd android \n  ./gradlew clean  \n ./gradlew assembleRelease",
    "release:prod": "npm run cc && gulp set --env=prod && cd android \n  ./gradlew clean  \n ./gradlew assembleRelease",
    "bundle:stage": "npm run cc && gulp set --env=stage && cd android \n  ./gradlew clean  \n ./gradlew bundleRelease",
    "reinstall": "rm -rf package-lock.json && rm -rf node_modules && npm i --exact"
  },
