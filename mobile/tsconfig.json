{
  "compilerOptions": {
    "types": [
      "node",
      "react",
      "react-native",
      "jest"
    ],
    "lib": [
      "esnext"
    ],
    "skipLibCheck": true,
    "jsx": "react"
  },
  "extends": "@react-native/typescript-config",
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ],
  "baseUrl": "src",
  "paths": {
    "@/*": [
      "*"
    ]
  }
}